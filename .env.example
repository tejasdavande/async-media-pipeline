PORT=3000

# mongo holds media records and job status
MONGO_URI=mongodb://localhost:27017/media_pipeline

# s3 bucket for raw uploads and processed output; S3_ENDPOINT + S3_FORCE_PATH_STYLE point it at localstack locally,
# leave both unset for real aws
S3_BUCKET=media
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
